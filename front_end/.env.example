# URL gốc của API backend. Để trống nếu dùng proxy /api của Vite khi dev.
VITE_API_BASE_URL=/api

# Đích proxy khi chạy `npm run dev` (chỉ dùng ở môi trường dev)
VITE_PROXY_TARGET=http://localhost:8000

# Tên hiển thị trên sidebar / trang đăng nhập
VITE_APP_NAME=BẢO HIỂM

# true = dùng dữ liệu giả trong trình duyệt, không cần backend.
# Đăng nhập: admin@baohiem.vn / admin123. Đặt false khi đã có API thật.
VITE_DEMO_MODE=true
